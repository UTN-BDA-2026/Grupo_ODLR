# MongoDB (Primary Database)
# En docker-compose la URL la define cada servicio con credenciales + TLS;
# este valor es el fallback para correr la app fuera de Docker.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pdf_extract_db
SECRET_KEY=change-me-generate-a-strong-random-secret

# Credenciales MongoDB (docker-compose). Genera valores fuertes, p.ej. `openssl rand -hex 24`
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-strong-root-password
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=change-me-strong-app-password

# Migration Settings
MIGRATION_CREATE_BACKUPS=true
MIGRATION_BACKUP_DIR=./migrations/backups

# Application
APP_NAME="FastAPI MVC Application"
APP_VERSION=1.0.0
DEBUG=true



# CORS (JSON array format)
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8000"]

# Logging Configuration
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Format: text (for dev), json (for production)
LOG_FORMAT=text

# Enable correlation IDs for distributed tracing
LOG_CORRELATION_ID=true

# Añadimos la configuración para Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b